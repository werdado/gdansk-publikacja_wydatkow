{
  "name": "gdansk-rejestr-wydatkow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:poc": "node scripts/przygotuj-poc.ts",
    "prepare:site": "node scripts/przygotuj-strone.ts",
    "dev:poc": "npm run prepare:poc && vite --host 0.0.0.0",
    "build:poc": "npm run prepare:poc && npm run typecheck && vite build",
    "preview:poc": "vite preview --host 0.0.0.0",
    "evaluate:search": "node --expose-gc scripts/ocen-wyszukiwanie.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test poc/tests/search.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
